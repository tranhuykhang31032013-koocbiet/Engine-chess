name: Stockfish Ultimate Duel

on:
  workflow_dispatch:
    inputs:
      duration:
        description: 'Thời lượng đấu thực tế (Duration: 1 - 6 Hours, không tính thời gian build)'
        required: true
        default: '1 Hour'
        type: choice
        options:
          - '1 Hour'
          - '2 Hours'
          - '3 Hours'
          - '4 Hours'
          - '5 Hours'
          - '6 Hours'
      move_time:
        description: 'Thời gian suy nghĩ mỗi nước (Move Time)'
        required: true
        default: '200 ms'
        type: choice
        options:
          - '100 ms'
          - '200 ms'
          - '500 ms'
      hash:
        description: 'Dung lượng bộ nhớ Hash cho mỗi engine (Hash Size)'
        required: true
        default: '256 MB'
        type: choice
        options:
          - '128 MB'
          - '256 MB'
          - '512 MB'

permissions:
  contents: read

jobs:
  stage1_tournament:
    name: "Stage 1 — Unpack Logic, Build & Tournament (Up to 3h)"
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 220
    outputs:
      needs_stage2: ${{ steps.plan.outputs.needs_stage2 }}
      duration_hours: ${{ steps.plan.outputs.duration_hours }}
      stage1_hours: ${{ steps.plan.outputs.stage1_hours }}
      stage2_hours: ${{ steps.plan.outputs.stage2_hours }}

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Unpack Duel Logic Archive from Root (duel-logic.zip)
        run: |
          python3 - << 'PYEOF'
          import glob, os, stat, tarfile, zipfile
          candidates = [
              "duel-logic.zip",
              "Stockfish-Ultimate-Duel-Logic.zip",
              "Stockfish-Ultimate-Duel-GitHub-Actions.zip",
              "duel-logic.tar.gz",
          ]
          for pattern in ("*logic*.zip", "*duel*.zip", "*Duel*.zip", "*logic*.tar.gz"):
              for m in sorted(glob.glob(pattern)):
                  if m not in candidates:
                      candidates.append(m)
          for archive in candidates:
              if os.path.isfile(archive):
                  print(f"[UNPACK] Đang giải nén gói logic '{archive}' tại thư mục gốc...")
                  if archive.endswith(".zip"):
                      with zipfile.ZipFile(archive, "r") as zf:
                          zf.extractall(".")
                  elif archive.endswith(".tar.gz") or archive.endswith(".tgz"):
                      with tarfile.open(archive, "r:gz") as tf:
                          tf.extractall(".")
                  break
          for fpath in glob.glob("scripts/*.sh") + glob.glob("scripts/*.py") + glob.glob("tests/*.py"):
              if os.path.isfile(fpath):
                  os.chmod(fpath, os.stat(fpath).st_mode | stat.S_IEXEC | stat.S_IXGRP | stat.S_IXOTH)
          if not os.path.isfile("scripts/tournament.py") or not os.path.isfile("scripts/build_engines.sh"):
              raise SystemExit("[ERROR] Không tìm thấy scripts/tournament.py hoặc scripts/build_engines.sh! Hãy upload duel-logic.zip ở thư mục gốc của repository.")
          print("[UNPACK] Đã giải nén thành công bộ logic và áp dụng vào 2 tệp engine ở thư mục gốc.")
          PYEOF

      - name: Install Python Dependencies
        run: |
          python3 -m pip install --upgrade pip
          python3 -m pip install -r requirements.txt

      - name: Compute Stage Plan (1-3h Single Stage vs 4-6h Two Stages)
        id: plan
        run: |
          python3 scripts/tournament.py --plan-stages --duration "${{ inputs.duration }}"

      - name: Inspect Root Engine Files, Verify Provenance & Build Both Engines
        run: |
          chmod +x scripts/build_engines.sh
          ./scripts/build_engines.sh

      - name: Run Unit & Sanity Tests Before Tournament
        run: |
          python3 -m unittest discover -s tests -p "test_*.py" -v

      - name: Run Tournament — Stage 1 (${{ steps.plan.outputs.stage1_hours }}h Play Time)
        run: |
          python3 scripts/tournament.py \
            --stage 1 \
            --pro-bin build/bin/stockfish-pro \
            --uni-bin build/bin/stockfish-universal \
            --results-dir results \
            --manifest results/build-manifest.json \
            --duration "${{ inputs.duration }}" \
            --move-time "${{ inputs.move_time }}" \
            --hash "${{ inputs.hash }}" \
            --threads 1

      - name: Publish Stage 1 Summary to GitHub Step Summary
        if: always()
        run: |
          if [ -f results/summary.md ]; then
            cat results/summary.md >> "$GITHUB_STEP_SUMMARY"
          fi

      - name: Upload Stage 1 Checkpoint & Binaries (For Stage 2 Resume / Recovery)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: Stockfish-Ultimate-Duel-Checkpoint-Stage1
          retention-days: 30
          if-no-files-found: warn
          path: |
            results/
            build/bin/

      - name: Upload Final Results Artifact (When 1-3h Selected or Stage 1 Halted)
        if: always() && (steps.plan.outputs.needs_stage2 != 'true' || failure() || cancelled())
        uses: actions/upload-artifact@v4
        with:
          name: Stockfish-Ultimate-Duel-Results
          retention-days: 30
          if-no-files-found: error
          path: |
            results/matches.log
            results/matches.pgn
            results/matches.csv
            results/matches.jsonl
            results/summary.json
            results/summary.md
            results/build-manifest.json
            results/checkpoint.json
            results/experience.bin

  stage2_tournament:
    name: "Stage 2 — Resume & Complete Remaining Tournament (4-6h)"
    needs: stage1_tournament
    if: needs.stage1_tournament.outputs.needs_stage2 == 'true'
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 220

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Unpack Duel Logic Archive from Root (duel-logic.zip)
        run: |
          python3 - << 'PYEOF'
          import glob, os, stat, tarfile, zipfile
          candidates = [
              "duel-logic.zip",
              "Stockfish-Ultimate-Duel-Logic.zip",
              "Stockfish-Ultimate-Duel-GitHub-Actions.zip",
              "duel-logic.tar.gz",
          ]
          for pattern in ("*logic*.zip", "*duel*.zip", "*Duel*.zip", "*logic*.tar.gz"):
              for m in sorted(glob.glob(pattern)):
                  if m not in candidates:
                      candidates.append(m)
          for archive in candidates:
              if os.path.isfile(archive):
                  print(f"[UNPACK] Đang giải nén gói logic '{archive}' tại thư mục gốc...")
                  if archive.endswith(".zip"):
                      with zipfile.ZipFile(archive, "r") as zf:
                          zf.extractall(".")
                  elif archive.endswith(".tar.gz") or archive.endswith(".tgz"):
                      with tarfile.open(archive, "r:gz") as tf:
                          tf.extractall(".")
                  break
          for fpath in glob.glob("scripts/*.sh") + glob.glob("scripts/*.py") + glob.glob("tests/*.py"):
              if os.path.isfile(fpath):
                  os.chmod(fpath, os.stat(fpath).st_mode | stat.S_IEXEC | stat.S_IXGRP | stat.S_IXOTH)
          PYEOF

      - name: Install Python Dependencies
        run: |
          python3 -m pip install --upgrade pip
          python3 -m pip install -r requirements.txt

      - name: Download Stage 1 Checkpoint & Built Binaries
        uses: actions/download-artifact@v4
        with:
          name: Stockfish-Ultimate-Duel-Checkpoint-Stage1
          path: .

      - name: Verify Restored Binaries & Hardware Environment
        run: |
          chmod +x scripts/build_engines.sh
          chmod +x build/bin/stockfish-pro build/bin/stockfish-universal || true
          SKIP_REBUILD_IF_PRESENT=true ./scripts/build_engines.sh

      - name: Resume Tournament — Stage 2 (Remaining ${{ needs.stage1_tournament.outputs.stage2_hours }}h Play Time)
        run: |
          python3 scripts/tournament.py \
            --stage 2 \
            --resume \
            --pro-bin build/bin/stockfish-pro \
            --uni-bin build/bin/stockfish-universal \
            --results-dir results \
            --manifest results/build-manifest.json \
            --duration "${{ inputs.duration }}" \
            --move-time "${{ inputs.move_time }}" \
            --hash "${{ inputs.hash }}" \
            --threads 1

      - name: Publish Final Summary to GitHub Step Summary
        if: always()
        run: |
          if [ -f results/summary.md ]; then
            cat results/summary.md >> "$GITHUB_STEP_SUMMARY"
          fi

      - name: Upload Final Results Artifact (Stockfish-Ultimate-Duel-Results)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: Stockfish-Ultimate-Duel-Results
          retention-days: 30
          overwrite: true
          if-no-files-found: error
          path: |
            results/matches.log
            results/matches.pgn
            results/matches.csv
            results/matches.jsonl
            results/summary.json
            results/summary.md
            results/build-manifest.json
            results/checkpoint.json
            results/experience.bin
